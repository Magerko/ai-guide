---
import { OG_ALT, OG_HEIGHT, OG_WIDTH } from '../site-config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(base + '/og/root.png', Astro.site ?? 'http://localhost:4321').href;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>MagerDev AI Guide — посібник зі ШІ / гайд по AI</title>
    <meta name="description" content="Безплатний посібник про ШІ-чати для людей без технічної освіти. Бесплатный гайд об AI-чатах для людей без технического образования." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MagerDev AI Guide — посібник зі ШІ / гайд по AI" />
    <meta property="og:description" content="Як улаштовані ШІ-чати і як ними користуватися, не вірячи їм сліпо. Как устроены AI-чаты и как ими пользоваться, не веря им вслепую." />
    <meta property="og:url" content={new URL(base + '/', Astro.site ?? 'http://localhost:4321').href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={OG_ALT.root} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="ru" href={`${base}/ru/`} />
    <link rel="alternate" hreflang="uk" href={`${base}/uk/`} />
    <script is:inline define:vars={{ base }}>
      // I redirect before the body is parsed, so a returning visitor never loads the preview frame.
      try {
        var saved = localStorage.getItem('guide-lang');
        if (saved === 'ru' || saved === 'uk') location.replace(base + '/' + saved + '/');
      } catch (e) {}
    </script>
  </head>
  <body>
    <iframe class="backdrop" src={`${base}/uk/`} title="" aria-hidden="true" tabindex="-1" loading="eager"></iframe>
    <div class="veil" aria-hidden="true"></div>

    <main>
      <section class="card">
        <h1>MagerDev AI Guide</h1>
        <p lang="uk">Короткий безплатний посібник про те, як улаштовані ШІ-чати і як ними користуватися, не вірячи їм сліпо.</p>
        <p lang="ru">Короткий бесплатный гайд о том, как устроены AI-чаты и как ими пользоваться, не веря им вслепую.</p>
        <nav aria-label="Мова / Язык">
          <a href={`${base}/uk/`} lang="uk" hreflang="uk" data-lang="uk">Українська</a>
          <a href={`${base}/ru/`} lang="ru" hreflang="ru" data-lang="ru">Русский</a>
        </nav>
      </section>
    </main>

    <script is:inline>
      (function () {
        var links = document.querySelectorAll('nav a[data-lang]');
        var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language];
        for (var i = 0; i < langs.length; i++) {
          var code = String(langs[i] || '').toLowerCase().slice(0, 2);
          if (code === 'uk' || code === 'ru') {
            var pick = document.querySelector('nav a[data-lang="' + code + '"]');
            if (pick) pick.classList.add('preferred');
            break;
          }
        }
        links.forEach(function (a) {
          a.addEventListener('click', function () {
            try {
              localStorage.setItem('guide-lang', a.getAttribute('data-lang'));
            } catch (e) {}
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fff;
    --fg: #1b1b1f;
    --muted: #4a4d57;
    --accent: #3b5bdb;
    --on-accent: #fff;
    --veil: rgba(255, 255, 255, 0.55);
    --card: rgba(255, 255, 255, 0.82);
    --line: rgba(27, 27, 31, 0.15);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17181c;
      --fg: #eceef3;
      --muted: #b8bcc8;
      --accent: #8da2ff;
      --on-accent: #101218;
      --veil: rgba(23, 24, 28, 0.6);
      --card: rgba(30, 32, 38, 0.82);
      --line: rgba(236, 238, 243, 0.18);
    }
  }
  html {
    background: var(--bg);
  }
  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    font-family: system-ui, sans-serif;
    color: var(--fg);
  }
  .backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    /* Slight scale hides the transparent edge that blur leaves at the borders. */
    transform: scale(1.04);
    filter: blur(7px);
    pointer-events: none;
  }
  .veil {
    position: fixed;
    inset: 0;
    background: var(--veil);
  }
  main {
    position: relative;
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .card {
    box-sizing: border-box;
    width: 100%;
    max-width: 30rem;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--card);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.18);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    text-align: center;
  }
  h1 {
    margin: 0 0 1rem;
    font-size: 1.75rem;
    line-height: 1.2;
  }
  .card p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    line-height: 1.45;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  nav a {
    padding: 0.85rem 1.25rem;
    border: 2px solid var(--accent);
    border-radius: 0.6rem;
    color: var(--accent);
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
  }
  nav a.preferred {
    background: var(--accent);
    color: var(--on-accent);
  }
  nav a:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  nav a:focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
  }
  @media (min-width: 30rem) {
    nav {
      flex-direction: row;
    }
    nav a {
      flex: 1;
    }
  }
</style>
