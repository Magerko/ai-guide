---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>MagerDev AI Guide</title>
    <link rel="alternate" hreflang="ru" href={`${base}/ru/`} />
    <link rel="alternate" hreflang="uk" href={`${base}/uk/`} />
  </head>
  <body>
    <main>
      <h1>MagerDev AI Guide</h1>
      <p>Выбери язык / Обери мову</p>
      <nav>
        <a href={`${base}/ru/`}>Русский</a>
        <a href={`${base}/uk/`}>Українська</a>
      </nav>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fff;
    --fg: #1b1b1f;
    --accent: #3b5bdb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17181c;
      --fg: #eceef3;
      --accent: #8da2ff;
    }
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: system-ui, sans-serif;
    background: var(--bg);
    color: var(--fg);
    text-align: center;
  }
  main {
    padding: 1.5rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  nav a {
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
    color: var(--accent);
    font-size: 1.2rem;
    text-decoration: none;
  }
  nav a:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
